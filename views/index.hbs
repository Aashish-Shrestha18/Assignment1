<section class="intro">
  <h1>Tell us what went wrong with your vehicle</h1>
  <p>Fill in the work order below. A service manager will review it and contact you.
     Fields marked <span class="req">*</span> are required.</p>
</section>

{{#if hasErrors}}
<div class="alert" role="alert" tabindex="-1" id="server-alert">
  Your complaint wasn’t submitted. Fix the highlighted fields and try again.
</div>
{{/if}}

<form id="complaint-form" action="/complaints" method="POST" enctype="multipart/form-data" novalidate>

  <fieldset>
    <legend>Customer</legend>
    <div class="field {{#if errors.fullName}}invalid{{/if}}">
      <label for="fullName">Full name <span class="req">*</span></label>
      <input type="text" id="fullName" name="fullName" value="{{values.fullName}}" autocomplete="name" required minlength="2" maxlength="80">
      <p class="error" id="fullName-error">{{errors.fullName}}</p>
    </div>
    <div class="row">
      <div class="field {{#if errors.email}}invalid{{/if}}">
        <label for="email">Email address <span class="req">*</span></label>
        <input type="email" id="email" name="email" value="{{values.email}}" autocomplete="email" required>
        <p class="error" id="email-error">{{errors.email}}</p>
      </div>
      <div class="field {{#if errors.phone}}invalid{{/if}}">
        <label for="phone">Phone number <span class="req">*</span></label>
        <input type="tel" id="phone" name="phone" value="{{values.phone}}" autocomplete="tel" placeholder="306-555-0123" required>
        <p class="error" id="phone-error">{{errors.phone}}</p>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Vehicle</legend>
    <div class="row">
      <div class="field {{#if errors.vehicleMake}}invalid{{/if}}">
        <label for="vehicleMake">Vehicle make <span class="req">*</span></label>
        <input type="text" id="vehicleMake" name="vehicleMake" value="{{values.vehicleMake}}" placeholder="Toyota" required maxlength="40">
        <p class="error" id="vehicleMake-error">{{errors.vehicleMake}}</p>
      </div>
      <div class="field {{#if errors.vehicleModel}}invalid{{/if}}">
        <label for="vehicleModel">Vehicle model <span class="req">*</span></label>
        <input type="text" id="vehicleModel" name="vehicleModel" value="{{values.vehicleModel}}" placeholder="Corolla" required maxlength="40">
        <p class="error" id="vehicleModel-error">{{errors.vehicleModel}}</p>
      </div>
    </div>
    <div class="field {{#if errors.vin}}invalid{{/if}}">
      <label for="vin">VIN <span class="req">*</span></label>
      <input type="text" id="vin" name="vin" value="{{values.vin}}" placeholder="17 characters, e.g. 1HGCM82633A004352" maxlength="17" required class="mono">
      <p class="hint">Find it on the driver’s-side dashboard or door jamb. Letters I, O and Q are never used.</p>
      <p class="error" id="vin-error">{{errors.vin}}</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>Complaint</legend>
    <div class="field {{#if errors.subject}}invalid{{/if}}">
      <label for="subject">Subject <span class="req">*</span></label>
      <input type="text" id="subject" name="subject" value="{{values.subject}}" placeholder="Grinding noise after brake service" required minlength="5" maxlength="100">
      <p class="error" id="subject-error">{{errors.subject}}</p>
    </div>
    <div class="field {{#if errors.description}}invalid{{/if}}">
      <label for="description">What happened? <span class="req">*</span></label>
      <textarea id="description" name="description" rows="6" required minlength="20" maxlength="2000">{{values.description}}</textarea>
      <p class="hint"><span id="char-count">0</span> / 2000 characters (minimum 20)</p>
      <p class="error" id="description-error">{{errors.description}}</p>
    </div>
    <div class="field {{#if errors.images}}invalid{{/if}}">
      <label for="images">Photos (optional)</label>
      <input type="file" id="images" name="images" accept="image/jpeg,image/png,image/gif,image/webp" multiple>
      <p class="hint">Up to 5 images (JPG, PNG, GIF, WebP), 5 MB each. Files must be re-selected if the form reloads.</p>
      <p class="error" id="images-error">{{errors.images}}</p>
    </div>
  </fieldset>

  <button type="submit" class="btn">Submit complaint</button>
</form>

<script src="/js/validate.js"></script>
